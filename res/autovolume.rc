#include <winver.h>
#include "resource.h"

IDI_APP     ICON "autovolume.ico"
IDI_APP_OFF ICON "autovolume_off.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AutoVolume - automatic volume leveler"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "AutoVolume"
            VALUE "OriginalFilename", "AutoVolume.exe"
            VALUE "ProductName", "AutoVolume"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
